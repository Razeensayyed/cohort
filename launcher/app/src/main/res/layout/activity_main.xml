<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:focusable="false">

    <!-- Wallpaper background -->
    <ImageView
        android:id="@+id/iv_wallpaper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/wallpaper"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Dark gradient overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_gradient_overlay"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Top bar: clock left, pills right -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/top_bar_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/top_bar_padding"
        android:paddingEnd="@dimen/top_bar_padding"
        android:paddingTop="16dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left: greeting + clock + date -->
        <LinearLayout
            android:id="@+id/clock_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/greeting_text_size"
                android:fontFamily="@font/outfit_light"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tv_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_clock"
                    android:textSize="@dimen/clock_text_size"
                    android:fontFamily="@font/outfit_thin"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tv_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginBottom="10dp"
                    android:textColor="@color/text_clock"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit_light" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/date_text_size"
                android:fontFamily="@font/outfit_light" />
        </LinearLayout>

        <!-- Right: pill buttons -->
        <LinearLayout
            android:id="@+id/pill_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btn_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/pill_margin"
                android:paddingStart="@dimen/pill_padding_h"
                android:paddingEnd="@dimen/pill_padding_h"
                android:paddingTop="@dimen/pill_padding_v"
                android:paddingBottom="@dimen/pill_padding_v"
                android:background="@drawable/bg_pill"
                android:textColor="@color/pill_text"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_regular"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="Wi-Fi" />

            <TextView
                android:id="@+id/btn_inputs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/pill_margin"
                android:paddingStart="@dimen/pill_padding_h"
                android:paddingEnd="@dimen/pill_padding_h"
                android:paddingTop="@dimen/pill_padding_v"
                android:paddingBottom="@dimen/pill_padding_v"
                android:background="@drawable/bg_pill"
                android:textColor="@color/pill_text"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_regular"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/btn_inputs" />

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/pill_padding_h"
                android:paddingEnd="@dimen/pill_padding_h"
                android:paddingTop="@dimen/pill_padding_v"
                android:paddingBottom="@dimen/pill_padding_v"
                android:background="@drawable/bg_pill"
                android:textColor="@color/pill_text"
                android:textSize="13sp"
                android:fontFamily="@font/outfit_regular"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/btn_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- Focused dock app name -->
    <TextView
        android:id="@+id/tv_focused_app"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dock_margin_h"
        android:layout_marginBottom="8dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/focused_app_name_size"
        android:fontFamily="@font/outfit_light"
        android:alpha="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dock_container" />

    <!-- More apps panel (floating, above dock right side, hidden by default) -->
    <FrameLayout
        android:id="@+id/more_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dock_margin_h"
        android:layout_marginBottom="8dp"
        android:background="@color/inputs_dropdown_bg"
        android:padding="8dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/dock_container"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/more_recycler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:focusable="true" />
    </FrameLayout>

    <!-- Dock band (horizontal: main dock + Apps nav button) -->
    <LinearLayout
        android:id="@+id/dock_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/dock_height"
        android:layout_marginStart="@dimen/dock_margin_h"
        android:layout_marginEnd="@dimen/dock_margin_h"
        android:layout_marginBottom="@dimen/dock_margin_v"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_dock"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock_recycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:focusable="true" />

        <!-- Apps nav button -->
        <LinearLayout
            android:id="@+id/more_btn"
            android:layout_width="70dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true"
            android:background="@drawable/bg_pill">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8942;"
                android:textSize="22sp"
                android:textColor="@android:color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apps"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/outfit_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- Inputs dropdown -->
    <LinearLayout
        android:id="@+id/inputs_dropdown"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/inputs_dropdown_bg"
        android:padding="8dp"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@id/btn_inputs"
        app:layout_constraintEnd_toEndOf="@id/btn_inputs" />

</androidx.constraintlayout.widget.ConstraintLayout>
