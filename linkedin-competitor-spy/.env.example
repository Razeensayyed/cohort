# Copy this file to .env and fill it in.

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Apify token (free plan, $5/month credit): https://console.apify.com/settings/integrations
# Not needed if you run with --source csv
APIFY_TOKEN=

# Google Sheet ID: the long string in the sheet URL between /d/ and /edit
GOOGLE_SHEET_ID=
# Path to the Google service account key (defaults to ./service_account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Your niche, so Claude's content ideas fit you. Example: "B2B lead gen for SaaS founders"
MY_NICHE=

# Optional overrides
# SOURCE=apify
# MAX_POSTS=10
# DAYS=30
# CLAUDE_MODEL=claude-opus-5
# APIFY_ACTOR=harvestapi/linkedin-profile-posts
# APIFY_INPUT_JSON={"targetUrls": ["{url}"], "maxPosts": "{max_posts}"}
