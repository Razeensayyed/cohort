# Copy to .env and fill in. Never commit .env.

# Google Sheets (required unless you always use --dry-run)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=paste-the-id-from-the-sheet-url

# Optional: AI-written summary in the Digest tab. Leave empty to skip.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
