# Copy to .env and fill in. Never commit .env.

# Google Sheets (required unless you always use --dry-run)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=paste-the-id-from-the-sheet-url

# Optional: AI summary + AI topic labels for Winning Topics. Leave empty to skip.
ANTHROPIC_API_KEY=
# Optional model override; leave empty for the default (claude-opus-5).
ANTHROPIC_MODEL=
